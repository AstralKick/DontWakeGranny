function B.root()
	local m = workspace:FindFirstChild("Maps") return m and m:FindFirstChild("StMildreds")
end
function B.F(name, parent)
	parent = parent or B.root()
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end
function B.model(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- o: solid (structure: collide+query), small (clutter: no collide, no shadow), inv (invisible helper),
--    collide, query, touch, shadow, tr, shape, class, refl
function B.part(parent, name, size, cf, color, mat, o)
	o = o or {}
	local p = Instance.new(o.class or "Part")
	if o.shape then p.Shape = o.shape end
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf + B.O
	p.Color = color or B.C.Paper
	p.Material = mat or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if o.inv then
		p.Transparency = 1
		p.CanCollide = o.collide or false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
	else
		p.CanCollide = if o.collide ~= nil then o.collide else not o.small
		p.CanQuery = if o.query ~= nil then o.query else (o.solid == true)
		p.CanTouch = o.touch or false
		p.CastShadow = if o.shadow ~= nil then o.shadow else not o.small
		p.Transparency = o.tr or 0
	end
	if o.refl then p.Reflectance = o.refl end
	p.Parent = parent
	return p
end
-- axis-aligned box from bounds
function B.box(parent, name, x0, y0, z0, x1, y1, z1, color, mat, o)
	local mn = Vector3.new(math.min(x0, x1), math.min(y0, y1), math.min(z0, z1))
	local mx = Vector3.new(math.max(x0, x1), math.max(y0, y1), math.max(z0, z1))
	return B.part(parent, name, mx - mn, CFrame.new((mn + mx) / 2), color, mat, o)
end
local DIR = { ["-z"] = 0, ["+z"] = 180, ["+x"] = -90, ["-x"] = 90 }
-- base CFrame on the floor, LookVector = dir ("-z","+z","+x","-x" or degrees)
function B.cf(x, y, z, dir)
	local deg = if type(dir) == "number" then dir else (DIR[dir or "-z"] or 0)
	return CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(deg), 0)
end
-- relative part: base * offset. Shapes are only set by B.cyl/B.ball (a shared options table must never carry one).
function B.rp(parent, name, base, size, off, color, mat, o, rot)
	local cf = base * CFrame.new(off)
	if rot then cf = cf * rot end
	if o and o.shape then
		o = table.clone(o)
		o.shape = nil
	end
	return B.part(parent, name, size, cf, color, mat, o)
end
function B.cyl(parent, name, base, dia, len, off, color, mat, o, vertical)
	o = table.clone(o or {})
	o.shape = Enum.PartType.Cylinder
	local cf = base * CFrame.new(off)
	if vertical ~= false then cf = cf * CFrame.Angles(0, 0, math.rad(90)) end
	return B.part(parent, name, Vector3.new(len, dia, dia), cf, color, mat, o)
end
function B.ball(parent, name, base, dia, off, color, mat, o)
	o = table.clone(o or {})
	o.shape = Enum.PartType.Ball
	return B.part(parent, name, Vector3.new(dia, dia, dia), base * CFrame.new(off), color, mat, o)
end
function B.attrs(inst, t)
	for k, v in t do inst:SetAttribute(k, v) end
	return inst
end
function B.tag(inst, t)
	CS:AddTag(inst, t)
	return inst
end
function B.csg(op, target, tools, o)
	o = o or {}
	local fn = if op == "sub" then GS.SubtractAsync elseif op == "int" then GS.IntersectAsync else GS.UnionAsync
	local ok, res = pcall(fn, GS, target, tools, {
		CollisionFidelity = o.fid or Enum.CollisionFidelity.Box,
		RenderFidelity = Enum.RenderFidelity.Automatic,
		SplitApart = false,
	})
	if not ok or not res or not res[1] then
		warn("CSG failed for " .. target.Name .. ": " .. tostring(res))
		for _, t in tools do t:Destroy() end
		return target
	end
	local u = res[1]
	u.Name = target.Name
	u.Anchored = true
	u.CanCollide = target.CanCollide
	u.CanQuery = target.CanQuery
	u.CanTouch = target.CanTouch
	u.CastShadow = target.CastShadow
	u.UsePartColor = if o.usePartColor == nil then true else o.usePartColor
	u.Parent = target.Parent
	target:Destroy()
	for _, t in tools do t:Destroy() end
	return u
end
function B.cutter(size, cf, shape)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf + B.O
	if shape then p.Shape = shape end
	return p
end

----------------------------------------------------------------- walls
-- pieces of a wall line [a,b] from y0..y1 minus gaps {c,w,h,sill}
function B.pieces(a, b, y0, y1, gaps)
	local list = {}
	gaps = gaps or {}
	table.sort(gaps, function(g1, g2) return g1.c < g2.c end)
	local cur = a
	for _, g in gaps do
		local gs, ge = g.c - g.w / 2, g.c + g.w / 2
		if gs > cur + 0.01 then table.insert(list, { cur, gs, y0, y1, false }) end
		local sill = y0 + (g.sill or 0)
		local top = y0 + (g.h or 8)
		if sill > y0 + 0.01 then table.insert(list, { gs, ge, y0, sill, true }) end
		if top < y1 - 0.01 then table.insert(list, { gs, ge, top, y1, true }) end
		cur = ge
	end
	if b > cur + 0.01 then table.insert(list, { cur, b, y0, y1, false }) end
	return list
end
-- one skin layer. axis "x" = wall runs along X at z=fixed; "z" = runs along Z at x=fixed.
-- sign = which side faces the room (+1/-1 along the normal) for baseboards/wainscot.
function B.skin(parent, name, axis, fixed, a, b, y0, y1, thick, color, mat, gaps, sign, o)
	o = o or {}
	local parts = {}
	for _, pc in B.pieces(a, b, y0, y1, gaps) do
		local s, e, ya, yb = pc[1], pc[2], pc[3], pc[4]
		local p
		if axis == "x" then
			p = B.box(parent, name, s, ya, fixed - thick / 2, e, yb, fixed + thick / 2, color, mat, { solid = true })
		else
			p = B.box(parent, name, fixed - thick / 2, ya, s, fixed + thick / 2, yb, e, color, mat, { solid = true })
		end
		table.insert(parts, p)
		-- trim at floor level
		if sign and ya <= y0 + 0.01 and not o.nobase then
			local face = fixed + sign * thick / 2
			local th = if o.wain then 3.6 else 0.7
			local d = if o.wain then 0.12 else 0.18
			local col = o.trimColor or B.C.WoodDark
			local tp
			if axis == "x" then
				tp = B.box(parent, "Trim", s, y0, face, e, y0 + th, face + sign * d, col, if o.wain then M.Wood else M.SmoothPlastic, { small = true })
			else
				tp = B.box(parent, "Trim", face, y0, s, face + sign * d, y0 + th, e, col, if o.wain then M.Wood else M.SmoothPlastic, { small = true })
			end
			if o.wain then
				if axis == "x" then
					B.box(parent, "Rail", s, y0 + th, face, e, y0 + th + 0.3, face + sign * 0.25, B.C.WoodDark, M.Wood, { small = true })
				else
					B.box(parent, "Rail", face, y0 + th, s, face + sign * 0.25, y0 + th + 0.3, e, B.C.WoodDark, M.Wood, { small = true })
				end
			end
		end
	end
	return parts
end
-- interior wall, thickness 0.5, color on -side (cn) and +side (cp). on = opts for neg side, op = opts for pos side
function B.iwall(parent, axis, fixed, a, b, y0, y1, cn, cp, gaps, on, op)
	on = on or {}
	op = op or {}
	B.skin(parent, "Wall", axis, fixed - 0.125, a, b, y0, y1, 0.25, cn, on.mat or M.Plaster, gaps, -1, on)
	B.skin(parent, "Wall", axis, fixed + 0.125, a, b, y0, y1, 0.25, cp, op.mat or M.Plaster, gaps, 1, op)
	for _, g in gaps or {} do
		if (g.sill or 0) == 0 and g.trim ~= false then B.casing(parent, axis, fixed, g.c, g.w, y0, g.h or 8, 0.5) end
	end
end
-- door/opening casing: jambs + header, crossing the wall thickness
function B.casing(parent, axis, fixed, c, w, y0, h, wallT)
	local t = wallT + 0.3
	local col = B.C.WoodDark
	local o = { small = true }
	if axis == "x" then
		B.box(parent, "Casing", c - w / 2 - 0.35, y0, fixed - t / 2, c - w / 2, y0 + h + 0.35, fixed + t / 2, col, M.Wood, o)
		B.box(parent, "Casing", c + w / 2, y0, fixed - t / 2, c + w / 2 + 0.35, y0 + h + 0.35, fixed + t / 2, col, M.Wood, o)
		B.box(parent, "Casing", c - w / 2, y0 + h, fixed - t / 2, c + w / 2, y0 + h + 0.35, fixed + t / 2, col, M.Wood, o)
	else
		B.box(parent, "Casing", fixed - t / 2, y0, c - w / 2 - 0.35, fixed + t / 2, y0 + h + 0.35, c - w / 2, col, M.Wood, o)
		B.box(parent, "Casing", fixed - t / 2, y0, c + w / 2, fixed + t / 2, y0 + h + 0.35, c + w / 2 + 0.35, col, M.Wood, o)
		B.box(parent, "Casing", fixed - t / 2, y0 + h, c - w / 2, fixed + t / 2, y0 + h + 0.35, c + w / 2, col, M.Wood, o)
	end
end
-- window dressing inside a hole: glass, mullions, sill, optional curtains on the inner side (sign)
function B.window(parent, axis, fixed, c, y0, sill, top, w, wallT, sign, curtain)
	local m = B.model(parent, "Window")
	local yc = y0 + (sill + top) / 2
	local hgt = top - sill
	local base
	if axis == "x" then
		base = CFrame.new(c, yc, fixed) * CFrame.Angles(0, if sign > 0 then math.pi else 0, 0)
	else
		base = CFrame.new(fixed, yc, c) * CFrame.Angles(0, if sign > 0 then -math.pi / 2 else math.pi / 2, 0)
	end
	-- base LookVector points INTO the room (-Z local = room side)
	B.rp(m, "Glass", base, Vector3.new(w, hgt, 0.1), Vector3.new(0, 0, 0), B.C.Glass, M.Glass, { tr = 0.55, solid = true, shadow = false })
	B.rp(m, "Mullion", base, Vector3.new(0.2, hgt, 0.3), Vector3.new(0, 0, 0), B.C.Paper, M.Wood, { small = true })
	B.rp(m, "Mullion", base, Vector3.new(w, 0.2, 0.3), Vector3.new(0, hgt * 0.1, 0), B.C.Paper, M.Wood, { small = true })
	local frameC = B.C.Paper
	B.rp(m, "Frame", base, Vector3.new(w + 0.6, 0.3, wallT + 0.2), Vector3.new(0, hgt / 2 + 0.15, 0), frameC, M.Wood, { small = true })
	B.rp(m, "Sill", base, Vector3.new(w + 0.9, 0.3, wallT + 0.9), Vector3.new(0, -hgt / 2 - 0.15, -0.3), frameC, M.Wood, { small = true })
	B.rp(m, "Frame", base, Vector3.new(0.3, hgt, wallT + 0.2), Vector3.new(-w / 2 - 0.15, 0, 0), frameC, M.Wood, { small = true })
	B.rp(m, "Frame", base, Vector3.new(0.3, hgt, wallT + 0.2), Vector3.new(w / 2 + 0.15, 0, 0), frameC, M.Wood, { small = true })
	if curtain then
		local d = -(wallT / 2 + 0.35)
		B.rp(m, "Rod", base, Vector3.new(w + 3, 0.15, 0.15), Vector3.new(0, hgt / 2 + 0.8, d), B.C.WoodDark, M.Wood, { small = true })
		B.rp(m, "Curtain", base, Vector3.new(1.4, hgt + 2.2, 0.2), Vector3.new(-w / 2 - 0.5, -0.3, d), curtain, M.Fabric, { small = true })
		B.rp(m, "Curtain", base, Vector3.new(1.4, hgt + 2.2, 0.2), Vector3.new(w / 2 + 0.5, -0.3, d), curtain, M.Fabric, { small = true })
	end
	return m
end

----------------------------------------------------------------- contract helpers
function B.inv(parent, name, size, cf)
	return B.part(parent, name, size, cf, B.C.Paper, M.SmoothPlastic, { inv = true })
end
function B.room(name, area, danger, x0, y0, z0, x1, y1, z1)
	local p = B.box(B.F("Rooms"), name, x0, y0, z0, x1, y1, z1, B.C.Paper, M.SmoothPlastic, { inv = true })
	return B.attrs(p, { RoomName = name, Area = area, Danger = danger })
end
function B.loot(area, danger, pos)
	local p = B.inv(B.F("LootSpawns"), "LootSpawn", Vector3.new(0.8, 0.4, 0.8), CFrame.new(pos + Vector3.new(0, 0.35, 0)))
	return B.attrs(p, { Area = area, Danger = danger })
end
function B.prize(area, pos)
	local p = B.inv(B.F("PrizeSpawns"), "PrizeSpawn", Vector3.new(1.5, 0.4, 1.5), CFrame.new(pos + Vector3.new(0, 0.35, 0)))
	return B.attrs(p, { Area = area })
end
function B.node(area, x, y, z, bath)
	local p = B.inv(B.F("SearchNodes"), "SearchNode", Vector3.new(1, 0.2, 1), CFrame.new(x, y + 0.1, z))
	B.attrs(p, { Area = area })
	if bath then p:SetAttribute("Bathroom", true) end
	return p
end
function B.pumpkin(area, pos, face)
	local p = B.inv(B.F("PumpkinSpots"), "PumpkinSpot", Vector3.new(1.5, 0.2, 1.5), B.cf(pos.X, pos.Y + 0.1, pos.Z, face))
	return B.attrs(p, { Area = area })
end
function B.searchable(p, kind, area, danger)
	p.CanQuery = true
	B.tag(p, "Searchable")
	return B.attrs(p, { Kind = kind, Area = area, Danger = danger })
end
function B.creak(x, y, z, rot)
	local p = B.part(B.F("Creaky"), "CreakyBoard", Vector3.new(4, 0.2, 4), CFrame.new(x, y - 0.08, z) * CFrame.Angles(0, math.rad(rot or 0), 0), B.C.Creak, M.WoodPlanks, { collide = true, touch = true, query = true, shadow = false })
	return B.tag(p, "Creaky")
end
-- hinged door in a doorway gap. axis/fixed/c describe the gap (like B.pieces). hs = +1 hinge on low side, -1 on high side
function B.door(parent, name, axis, fixed, c, y0, area, squeaky, lockable, color, hs, w)
	hs = hs or 1
	w = w or 4.5
	local right = if axis == "x" then Vector3.xAxis else Vector3.zAxis
	local hinge = if axis == "x" then Vector3.new(c - hs * w / 2, y0, fixed) else Vector3.new(fixed, y0, c - hs * w / 2)
	local base = CFrame.fromMatrix(hinge, right * hs, Vector3.yAxis)
	local m = B.model(parent, name)
	local hp = B.rp(m, "Hinge", base, Vector3.new(0.2, 8, 0.2), Vector3.new(0, 4, 0), B.C.Paper, M.SmoothPlastic, { inv = true })
	local panel = B.rp(m, "Panel", base, Vector3.new(w - 0.1, 7.9, 0.3), Vector3.new(w / 2, 3.98, 0), color or B.C.WoodMid, M.Wood, { collide = true, query = true })
	local pm = Instance.new("PathfindingModifier")
	pm.PassThrough = true
	pm.Parent = panel
	local dk = (color or B.C.WoodMid):Lerp(B.C.Ink, 0.3)
	for _, zz in { -0.17, 0.17 } do
		B.rp(m, "Inset", base, Vector3.new(w - 1.3, 2.9, 0.06), Vector3.new(w / 2, 5.6, zz), dk, M.Wood, { small = true })
		B.rp(m, "Inset", base, Vector3.new(w - 1.3, 3.2, 0.06), Vector3.new(w / 2, 1.9, zz), dk, M.Wood, { small = true })
		B.ball(m, "Knob", base, 0.32, Vector3.new(w - 0.45, 3.6, zz * 1.6), B.C.Brass, M.Metal, { small = true })
	end
	m.PrimaryPart = hp
	B.attrs(m, { Area = area, Squeaky = squeaky, Lockable = lockable })
	B.tag(m, "Door")
	return m
end
-- HidingSpot helper parts. insideCF faces out. front/exit are Vector3 floor positions.
function B.hideParts(m, kind, area, insideCF, front, exit)
	B.part(m, "Inside", Vector3.new(1.6, 2, 1), insideCF, B.C.Paper, M.SmoothPlastic, { inv = true })
	B.part(m, "Front", Vector3.new(2, 0.2, 2), CFrame.new(front + Vector3.new(0, 0.1, 0)), B.C.Paper, M.SmoothPlastic, { inv = true })
	local ep = exit + Vector3.new(0, 0.5, 0) -- the service places the root at Exit + 2.5
	B.part(m, "Exit", Vector3.new(2, 1, 2), CFrame.lookAt(ep, ep + (exit - insideCF.Position) * Vector3.new(1, 0, 1)), B.C.Paper, M.SmoothPlastic, { inv = true })
	B.attrs(m, { Kind = kind, Area = area })
	B.tag(m, "HidingSpot")
	return m
end
-- lamp. kind: table, floor, hang, sconce, bare, porch, candle. base = CFrame on the surface/floor/ceiling/wall
function B.lamp(parent, kind, base, area, o)
	o = o or {}
	local m = B.model(parent, "Lamp_" .. kind)
	local warm = o.color or B.C.Warm
	local shade = o.shade or B.C.Rose
	local bulbPos
	local sm = { small = true }
	if kind == "table" then
		B.cyl(m, "Base", base, 0.9, 0.2, Vector3.new(0, 0.1, 0), B.C.Brass, M.Metal, sm)
		B.cyl(m, "Stem", base, 0.5, 1.4, Vector3.new(0, 0.9, 0), o.body or B.C.Mint, M.Glass, sm)
		B.cyl(m, "Shade", base, 1.8, 1.2, Vector3.new(0, 2.1, 0), shade, M.Fabric, { small = true, tr = 0.15 })
		bulbPos = Vector3.new(0, 1.95, 0)
	elseif kind == "floor" then
		B.cyl(m, "Base", base, 1.3, 0.2, Vector3.new(0, 0.1, 0), B.C.WoodDark, M.Wood, sm)
		B.cyl(m, "Pole", base, 0.2, 5.4, Vector3.new(0, 2.8, 0), B.C.Brass, M.Metal, sm)
		B.cyl(m, "Shade", base, 2.4, 1.6, Vector3.new(0, 5.9, 0), shade, M.Fabric, { small = true, tr = 0.15 })
		bulbPos = Vector3.new(0, 5.7, 0)
	elseif kind == "hang" then -- base at ceiling underside
		B.cyl(m, "Cord", base, 0.1, 2.2, Vector3.new(0, -1.1, 0), B.C.Ink, M.SmoothPlastic, sm)
		B.cyl(m, "Shade", base, 2.2, 0.9, Vector3.new(0, -2.5, 0), shade, M.Glass, { small = true, tr = 0.2 })
		bulbPos = Vector3.new(0, -2.8, 0)
	elseif kind == "bare" then
		B.cyl(m, "Cord", base, 0.08, o.drop or 1.8, Vector3.new(0, -(o.drop or 1.8) / 2, 0), B.C.Ink, M.SmoothPlastic, sm)
		bulbPos = Vector3.new(0, -(o.drop or 1.8) - 0.3, 0)
	elseif kind == "sconce" then -- base on wall surface, LookVector out of the wall
		B.rp(m, "Plate", base, Vector3.new(0.5, 0.9, 0.1), Vector3.new(0, 0, -0.05), B.C.Brass, M.Metal, sm)
		B.rp(m, "Arm", base, Vector3.new(0.12, 0.12, 0.6), Vector3.new(0, 0, -0.35), B.C.Brass, M.Metal, sm)
		B.cyl(m, "Shade", base, 0.8, 0.8, Vector3.new(0, 0.35, -0.65), shade, M.Glass, { small = true, tr = 0.25 })
		bulbPos = Vector3.new(0, 0.3, -0.65)
	elseif kind == "porch" then
		B.rp(m, "Plate", base, Vector3.new(0.7, 1.2, 0.15), Vector3.new(0, 0, -0.08), B.C.Ink, M.Metal, sm)
		B.rp(m, "Cage", base, Vector3.new(0.9, 1.3, 0.9), Vector3.new(0, 0, -0.65), B.C.Ink, M.Glass, { small = true, tr = 0.6 })
		B.rp(m, "Cap", base, Vector3.new(1.1, 0.2, 1.1), Vector3.new(0, 0.75, -0.65), B.C.Ink, M.Metal, sm)
		bulbPos = Vector3.new(0, 0, -0.65)
	elseif kind == "candle" then
		B.cyl(m, "Wax", base, 0.3, o.h or 0.8, Vector3.new(0, (o.h or 0.8) / 2, 0), B.C.Paper, M.SmoothPlastic, sm)
		bulbPos = Vector3.new(0, (o.h or 0.8) + 0.15, 0)
	end
	local bsz = if kind == "candle" then 0.18 elseif kind == "sconce" then 0.35 else 0.55
	local bulb = B.ball(m, "Bulb", base, bsz, bulbPos, if kind == "candle" then Color3.fromRGB(255, 170, 80) else Color3.fromRGB(255, 214, 160), M.Neon, sm)
	local l = Instance.new(o.spot and "SpotLight" or "PointLight")
	l.Color = warm
	l.Brightness = o.bright or 1
	l.Range = o.range or 16
	l.Shadows = o.shadows or false
	if o.spot then
		l.Face = Enum.NormalId.Bottom
		l.Angle = o.angle or 110
	end
	l.Parent = bulb
	m.PrimaryPart = bulb
	B.attrs(m, { Area = area })
	B.tag(m, "Lamp")
	return m
end
function B.count(folder)
	local n = 0
	for _, d in folder:GetDescendants() do
		if d:IsA("BasePart") then n += 1 end
	end
	return n
end

-- Furniture / prop builders. Requires house_00_lib (run it first). Adds functions to _G.HB.
-- Convention: base CFrame b sits on the floor at the footprint centre; b.LookVector = the front of the prop.

local C, M = B.C, B.M
local V = Vector3.new
local SM = { small = true }
local function R(m, n, b, sz, off, col, mat, o) return B.rp(m, n, b, sz, off, col, mat, o) end
local function dark(c, k) return c:Lerp(C.Ink, k or 0.35) end

function B.hideParts(m, kind, area, insideCF, front, exit)
	B.part(m, "Inside", V(1.6, 2, 1), insideCF, C.Paper, M.SmoothPlastic, { inv = true })
	B.part(m, "Front", V(2, 0.2, 2), CFrame.new(front + V(0, 0.1, 0)), C.Paper, M.SmoothPlastic, { inv = true })
	local ep = exit + V(0, 0.5, 0) -- the service places the root at Exit + 2.5
	local look = (exit - insideCF.Position) * V(1, 0, 1)
	if look.Magnitude < 0.1 then look = V(0, 0, -1) end
	B.part(m, "Exit", V(2, 1, 2), CFrame.lookAt(ep, ep + look), C.Paper, M.SmoothPlastic, { inv = true })
	B.attrs(m, { Kind = kind, Area = area })
	B.tag(m, "HidingSpot")
	return m
end

function B.table(par, b, w, d, h, col, o)
	o = o or {}
	local m = B.model(par, o.name or "Table")
	if o.oval then
		local top = R(m, "Top", b, V(w - d, 0.3, d), V(0, h - 0.15, 0), col, M.Wood)
		local c1 = B.cyl(m, "T", b, d, 0.3, V(-(w - d) / 2, h - 0.15, 0), col, M.Wood, {}, false)
		c1.CFrame = CFrame.new(B.O) * b * CFrame.new(-(w - d) / 2, h - 0.15, 0) * CFrame.Angles(0, 0, math.rad(90))
		local c2 = B.cyl(m, "T", b, d, 0.3, V((w - d) / 2, h - 0.15, 0), col, M.Wood)
		B.csg("union", top, { c1, c2 })
	else
		R(m, "Top", b, V(w, 0.3, d), V(0, h - 0.15, 0), col, M.Wood)
	end
	local lx, lz = w / 2 - (if o.oval then d * 0.3 else 0.45), d / 2 - 0.45
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			R(m, "Leg", b, V(0.35, h - 0.3, 0.35), V(sx * lx, (h - 0.3) / 2, sz * lz), dark(col, 0.15), M.Wood)
		end
	end
	R(m, "Apron", b, V(lx * 2, 0.4, lz * 2), V(0, h - 0.5, 0), dark(col, 0.2), M.Wood, SM)
	if o.cloth then
		R(m, "Runner", b, V(w * 0.8, 0.04, math.min(1.6, d * 0.4)), V(0, h + 0.02, 0), o.cloth, M.Fabric, SM)
	end
	return m, h
end

function B.chair(par, b, col, o)
	o = o or {}
	local m = B.model(par, "Chair")
	local sh = 1.9
	R(m, "Seat", b, V(1.9, 0.25, 1.9), V(0, sh, 0), col, M.Wood)
	if o.cushion then R(m, "Cushion", b, V(1.7, 0.2, 1.7), V(0, sh + 0.22, 0), o.cushion, M.Fabric, SM) end
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			R(m, "Leg", b, V(0.22, sh, 0.22), V(sx * 0.8, sh / 2, sz * 0.8), dark(col, 0.2), M.Wood, SM)
		end
		R(m, "Post", b, V(0.22, 2.6, 0.22), V(sx * 0.8, sh + 1.3, 0.8), dark(col, 0.2), M.Wood, SM)
	end
	R(m, "Back", b, V(1.5, 1.1, 0.15), V(0, sh + 1.9, 0.8), col, M.Wood, SM)
	R(m, "Slat", b, V(0.3, 1.2, 0.12), V(0, sh + 0.8, 0.8), col, M.Wood, SM)
	return m
end

-- big wing-back armchair. returns model, seat top height
function B.armchair(par, b, fab, name, o)
	o = o or {}
	local m = B.model(par, name or "Armchair")
	local w, d = o.w or 5, o.d or 4.8
	local pip = o.trim or C.Bruise
	local nc = { collide = false }
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			R(m, "Foot", b, V(0.4, 0.4, 0.4), V(sx * (w / 2 - 0.4), 0.2, sz * (d / 2 - 0.4)), C.WoodDark, M.Wood, SM)
		end
	end
	R(m, "Base", b, V(w, 1.3, d), V(0, 1.05, 0), fab, M.Fabric, nc)
	R(m, "Skirt", b, V(w + 0.1, 0.3, d + 0.1), V(0, 0.55, 0), pip, M.Fabric, SM)
	R(m, "Cushion", b, V(w - 1.7, 0.6, d - 1.2), V(0, 2.0, -0.4), fab:Lerp(C.Paper, 0.12), M.Fabric, nc)
	R(m, "Back", b, V(w, 5.0, 1.1), V(0, 3.5, d / 2 - 0.55), fab, M.Fabric)
	R(m, "BackTop", b, V(w - 0.6, 0.5, 1.0), V(0, 6.2, d / 2 - 0.55), fab, M.Fabric, SM)
	for _, sx in { -1, 1 } do
		R(m, "Arm", b, V(0.85, 1.3, d), V(sx * (w / 2 - 0.42), 2.35, 0), fab, M.Fabric, nc)
		R(m, "ArmRoll", b, V(1.0, 0.35, d + 0.1), V(sx * (w / 2 - 0.42), 3.1, 0), pip, M.Fabric, SM)
		R(m, "Wing", b, V(0.7, 2.6, 1.8), V(sx * (w / 2 - 0.35), 4.6, d / 2 - 1.3), fab, M.Fabric, SM)
	end
	if o.doily then R(m, "Doily", b, V(2.2, 1.1, 0.05), V(0, 5.3, d / 2 - 1.12), C.Paper, M.Fabric, SM) end
	if o.throw then R(m, "Throw", b, V(1.2, 1.9, d * 0.7), V(-(w / 2 - 0.42), 2.6, 0.2), o.throw, M.Fabric, SM) end
	return m, 2.3
end

function B.sofa(par, b, w, fab, o)
	o = o or {}
	local m = B.model(par, o.name or "Sofa")
	local d = 3.6
	R(m, "Base", b, V(w, 1.2, d), V(0, 0.95, 0), fab, M.Fabric)
	R(m, "Back", b, V(w, 2.6, 0.9), V(0, 2.4, d / 2 - 0.45), fab, M.Fabric)
	for _, sx in { -1, 1 } do
		R(m, "Arm", b, V(0.8, 1.2, d), V(sx * (w / 2 - 0.4), 2.1, 0), fab, M.Fabric)
		R(m, "Foot", b, V(0.35, 0.35, 0.35), V(sx * (w / 2 - 0.4), 0.17, -(d / 2 - 0.4)), C.WoodDark, M.Wood, SM)
	end
	local n = math.max(2, math.floor((w - 1.6) / 2.6))
	local cw = (w - 1.6) / n
	for i = 1, n do
		R(m, "Cushion", b, V(cw - 0.1, 0.5, d - 1.1), V(-(w - 1.6) / 2 + cw * (i - 0.5), 1.8, -0.4), fab:Lerp(C.Paper, 0.1), M.Fabric, SM)
	end
	if o.pillow then R(m, "Pillow", b, V(1.2, 1.2, 0.4), V(w / 2 - 1.5, 2.5, d / 2 - 1.1), o.pillow, M.Fabric, SM) end
	return m
end

-- bed with an under-bed hiding spot. b faces the foot of the bed.
function B.bed(par, b, w, l, frame, sheet, area, o)
	o = o or {}
	local m = B.model(par, o.name or "Bed")
	R(m, "Support", b, V(w, 0.4, l), V(0, 2.6, 0), frame, M.Wood)
	R(m, "Mattress", b, V(w - 0.3, 0.8, l - 0.5), V(0, 3.2, 0.1), C.Paper, M.Fabric)
	R(m, "Quilt", b, V(w, 0.25, l * 0.72), V(0, 3.7, -l * 0.14), sheet, M.Fabric)
	R(m, "QuiltSideL", b, V(0.1, 1.5, l * 0.72), V(-w / 2 - 0.05, 2.95, -l * 0.14), sheet, M.Fabric, SM)
	R(m, "QuiltSideR", b, V(0.1, 1.5, l * 0.72), V(w / 2 + 0.05, 2.95, -l * 0.14), sheet, M.Fabric, SM)
	R(m, "Fold", b, V(w + 0.05, 0.3, 0.8), V(0, 3.75, l * 0.22 + 0.2), C.Paper, M.Fabric, SM)
	R(m, "Pillow", b, V(w * 0.4, 0.5, 1.3), V(-w * 0.22, 3.85, l / 2 - 1.1), C.Paper, M.Fabric, SM)
	R(m, "Pillow", b, V(w * 0.4, 0.5, 1.3), V(w * 0.22, 3.85, l / 2 - 1.1), C.Paper, M.Fabric, SM)
	-- skirt hides the space underneath (one panel per side)
	local sk = o.skirt or dark(sheet, 0.1)
	R(m, "Skirt", b, V(w, 2.3, 0.1), V(0, 1.25, -l / 2 + 0.05), sk, M.Fabric)
	R(m, "Skirt", b, V(0.1, 2.3, l), V(-w / 2 + 0.05, 1.25, 0), sk, M.Fabric)
	R(m, "Skirt", b, V(0.1, 2.3, l), V(w / 2 - 0.05, 1.25, 0), sk, M.Fabric)
	R(m, "Head", b, V(w + 0.6, 6, 0.4), V(0, 3, l / 2 + 0.2), frame, M.Wood)
	R(m, "HeadCap", b, V(w + 1, 0.35, 0.6), V(0, 6.1, l / 2 + 0.2), dark(frame), M.Wood, SM)
	R(m, "Foot", b, V(w + 0.6, 4, 0.35), V(0, 2, -l / 2 - 0.15), frame, M.Wood)
	for _, sx in { -1, 1 } do
		B.ball(m, "Finial", b, 0.55, V(sx * (w / 2 + 0.2), 4.2, -l / 2 - 0.15), dark(frame), M.Wood, SM)
	end
	-- hiding: player lies prone under the bed, head toward the foot
	local pos = (b * CFrame.new(0, 1.1, 0.8)).Position
	local inside = CFrame.fromMatrix(pos, b.RightVector, b.LookVector)
	B.hideParts(m, "Bed", area, inside, (b * CFrame.new(0, 0, -l / 2 - 2)).Position, (b * CFrame.new(1.5, 0, -l / 2 - 2.2)).Position)
	return m
end

-- wardrobe/closet/cabinet with an enclosed interior. kind: Wardrobe/Closet/Cabinet
function B.wardrobe(par, b, col, area, kind, o)
	o = o or {}
	local m = B.model(par, o.name or kind)
	local w, d, h = o.w or 5.2, 3.8, o.h or 8.8
	R(m, "Back", b, V(w, h, 0.3), V(0, h / 2, d / 2 - 0.15), col, M.Wood)
	for _, sx in { -1, 1 } do
		R(m, "Side", b, V(0.3, h, d), V(sx * (w / 2 - 0.15), h / 2, 0), col, M.Wood)
	end
	R(m, "Top", b, V(w, 0.4, d), V(0, h - 0.2, 0), col, M.Wood)
	R(m, "Crown", b, V(w + 0.5, 0.45, d + 0.3), V(0, h + 0.2, -0.15), dark(col), M.Wood, SM)
	R(m, "Plinth", b, V(w, 0.5, d), V(0, 0.25, 0), dark(col), M.Wood)
	local dc = o.doorColor or col
	local lw = (w - 0.1) / 2
	for _, sx in { -1, 1 } do
		local cx = sx * lw / 2
		R(m, "DoorLeaf", b, V(lw - 0.04, h - 1.0, 0.25), V(cx, 0.5 + (h - 1) / 2, -d / 2 + 0.125), dc, M.Wood)
		if o.louvre then
			for i = 1, 7 do
				R(m, "Louvre", b, V(lw - 0.7, 0.12, 0.1), V(cx, 1.6 + i * 0.75, -d / 2 - 0.02), dark(dc, 0.25), M.Wood, SM)
			end
		else
			R(m, "Inset", b, V(lw - 0.8, h * 0.36, 0.06), V(cx, 0.5 + h * 0.66, -d / 2 - 0.02), dark(dc, 0.2), M.Wood, SM)
			R(m, "Inset", b, V(lw - 0.8, h * 0.3, 0.06), V(cx, 0.5 + h * 0.22, -d / 2 - 0.02), dark(dc, 0.2), M.Wood, SM)
		end
		B.ball(m, "Knob", b, 0.28, V(sx * 0.35, 4.2, -d / 2 - 0.12), C.Brass, M.Metal, SM)
	end
	local inside = b * CFrame.new(0, 3.1, 0.2)
	B.hideParts(m, kind, area, inside, (b * CFrame.new(0, 0, -d / 2 - 2.1)).Position, (b * CFrame.new(0, 0, -d / 2 - 2)).Position)
	return m
end

-- dresser / chest of drawers. searchIdx = which drawer (1 = top) is Searchable Drawer
function B.dresser(par, b, w, d, h, col, n, area, danger, o)
	o = o or {}
	local m = B.model(par, o.name or "Dresser")
	R(m, "Body", b, V(w, h - 0.3, d), V(0, (h - 0.3) / 2 + 0.3, 0), col, M.Wood)
	R(m, "Top", b, V(w + 0.3, 0.2, d + 0.2), V(0, h + 0.1, -0.05), dark(col, 0.25), M.Wood)
	for _, sx in { -1, 1 } do
		R(m, "Foot", b, V(0.4, 0.3, 0.4), V(sx * (w / 2 - 0.3), 0.15, -(d / 2 - 0.3)), dark(col), M.Wood, SM)
	end
	local dh = (h - 0.6) / n
	for i = 1, n do
		local y = h - 0.15 - dh * (i - 0.5)
		local f = R(m, "DrawerFront", b, V(w - 0.4, dh - 0.15, 0.15), V(0, y, -d / 2 - 0.07), dark(col, 0.1), M.Wood, { collide = false })
		for _, sx in { -1, 1 } do
			B.ball(m, "Pull", b, 0.22, V(sx * w * 0.25, y, -d / 2 - 0.2), C.Brass, M.Metal, SM)
		end
		if o.search and table.find(o.search, i) then
			f.Name = "Drawer"
			B.searchable(f, o.kind or "Drawer", area, danger)
		end
	end
	return m, h + 0.2
end

-- kitchen base counter run along local X; returns model. search = { [i] = "Cabinet"/"Drawer" }
function B.counter(par, b, len, col, top, area, danger, search, o)
	o = o or {}
	local m = B.model(par, o.name or "Counter")
	local d, h = 2.6, 3.4
	R(m, "Body", b, V(len, h - 0.5, d - 0.2), V(0, (h - 0.5) / 2 + 0.4, 0.1), col, M.Wood)
	R(m, "Toe", b, V(len, 0.4, d - 0.5), V(0, 0.2, 0.25), C.WoodDark, M.Wood, SM)
	if not o.noTop then R(m, "Countertop", b, V(len + 0.2, 0.3, d + 0.2), V(0, h - 0.05, 0), top, M.Marble) end
	local n = math.max(1, math.floor(len / 2.5 + 0.5))
	local cw = len / n
	for i = 1, n do
		local x = -len / 2 + cw * (i - 0.5)
		local kind = search and search[i]
		local door = R(m, "CabDoor", b, V(cw - 0.25, 1.9, 0.12), V(x, 1.5, -d / 2 - 0.06), dark(col, 0.05), M.Wood, { collide = false })
		local drw = R(m, "DrawerFront", b, V(cw - 0.25, 0.6, 0.12), V(x, 2.85, -d / 2 - 0.06), dark(col, 0.05), M.Wood, { collide = false })
		B.ball(m, "Pull", b, 0.18, V(x + cw * 0.3, 2.1, -d / 2 - 0.16), C.Brass, M.Metal, SM)
		B.ball(m, "Pull", b, 0.18, V(x, 2.85, -d / 2 - 0.16), C.Brass, M.Metal, SM)
		if kind == "Cabinet" then
			door.Name = "Cabinet"
			B.searchable(door, "Cabinet", area, danger)
		elseif kind == "Drawer" then
			drw.Name = "Drawer"
			B.searchable(drw, "Drawer", area, danger)
		end
	end
	return m, h + 0.1
end

-- upper wall cabinets (b on the floor against the wall)
function B.uppers(par, b, len, col, search, area, danger)
	local m = B.model(par, "UpperCabinets")
	local n = math.max(1, math.floor(len / 2.5 + 0.5))
	local cw = len / n
	R(m, "Body", b, V(len, 3, 1.4), V(0, 8.2, 0.7), col, M.Wood)
	R(m, "Crown", b, V(len + 0.2, 0.3, 1.7), V(0, 9.85, 0.6), dark(col), M.Wood, SM)
	for i = 1, n do
		local x = -len / 2 + cw * (i - 0.5)
		local dp = R(m, "CabDoor", b, V(cw - 0.2, 2.7, 0.1), V(x, 8.2, -0.05), dark(col, 0.05), M.Wood, { collide = false })
		B.ball(m, "Pull", b, 0.16, V(x + cw * 0.3, 7.3, -0.15), C.Brass, M.Metal, SM)
		if search and search[i] then
			dp.Name = "Cabinet"
			B.searchable(dp, "Cabinet", area, danger)
		end
	end
	return m
end

function B.fridge(par, b, area, danger)
	local m = B.model(par, "Fridge")
	local col = C.Mint:Lerp(C.Paper, 0.25)
	R(m, "Body", b, V(3.2, 7, 2.6), V(0, 3.6, 0.2), col, M.SmoothPlastic)
	local door = R(m, "FridgeDoor", b, V(3.1, 4.4, 0.3), V(0, 2.6, -1.25), col, M.SmoothPlastic, { collide = false })
	B.searchable(door, "Fridge", area, danger)
	R(m, "FreezerDoor", b, V(3.1, 2.0, 0.3), V(0, 6.0, -1.25), col, M.SmoothPlastic, { collide = false })
	R(m, "Handle", b, V(0.15, 1.6, 0.25), V(1.2, 3.8, -1.5), C.Metal, M.Metal, SM)
	R(m, "Handle", b, V(0.15, 0.8, 0.25), V(1.2, 5.6, -1.5), C.Metal, M.Metal, SM)
	R(m, "Badge", b, V(0.9, 0.2, 0.05), V(0, 4.5, -1.42), C.Brass, M.Metal, SM)
	R(m, "Note", b, V(0.6, 0.7, 0.03), V(-0.8, 3.6, -1.42), C.Paper, M.SmoothPlastic, SM)
	R(m, "Magnet", b, V(0.2, 0.2, 0.06), V(-0.8, 3.95, -1.44), C.Blood, M.SmoothPlastic, SM)
	R(m, "Drawing", b, V(0.8, 0.6, 0.03), V(0.2, 2.2, -1.42), C.Mustard:Lerp(C.Paper, 0.5), M.SmoothPlastic, SM)
	return m
end

function B.stove(par, b)
	local m = B.model(par, "Stove")
	R(m, "Body", b, V(3.2, 3.3, 2.6), V(0, 1.65, 0), C.Paper:Lerp(C.Ink, 0.08), M.SmoothPlastic)
	R(m, "OvenDoor", b, V(2.6, 1.7, 0.12), V(0, 1.4, -1.33), C.Paper:Lerp(C.Ink, 0.15), M.SmoothPlastic, SM)
	R(m, "OvenWindow", b, V(1.6, 0.8, 0.05), V(0, 1.5, -1.4), C.Ink, M.Glass, SM)
	R(m, "BackPanel", b, V(3.2, 1.0, 0.3), V(0, 3.8, 1.15), C.Paper:Lerp(C.Ink, 0.08), M.SmoothPlastic, SM)
	for i, x in { -0.8, 0.8 } do
		for _, z in { -0.55, 0.55 } do
			B.cyl(m, "Burner", b, 0.9, 0.08, V(x, 3.34, z), C.Ink, M.Metal, SM, true)
		end
		R(m, "Knob", b, V(0.25, 0.25, 0.1), V(x * 1.2, 3.8, 0.95), C.Ink, M.SmoothPlastic, SM)
	end
	-- kettle
	B.cyl(m, "Kettle", b, 0.8, 0.7, V(0.8, 3.75, -0.55), C.Blood:Lerp(C.Ink, 0.2), M.SmoothPlastic, SM, true)
	return m
end

-- CRT TV on a wooden console. Tagged Lamp (the glowing screen is the Bulb).
function B.tv(par, b, area)
	local m = B.model(par, "CRT_TV")
	R(m, "Console", b, V(4.4, 2.2, 2.4), V(0, 1.1, 0), C.WoodMid, M.Wood)
	R(m, "ConsoleTop", b, V(4.6, 0.15, 2.5), V(0, 2.27, 0), C.WoodDark, M.Wood, SM)
	R(m, "Grille", b, V(3.6, 1.2, 0.05), V(0, 1.2, -1.22), C.WoodDark, M.Fabric, SM)
	R(m, "Box", b, V(3.6, 2.9, 2.6), V(0, 3.8, 0.1), C.Ink:Lerp(C.WoodDark, 0.5), M.Wood)
	R(m, "Bezel", b, V(3.3, 2.6, 0.1), V(-0.2, 3.8, -1.2), C.Ink, M.SmoothPlastic, SM)
	local scr = R(m, "Bulb", b, V(2.5, 2.0, 0.1), V(-0.35, 3.8, -1.25), Color3.fromRGB(96, 108, 130), M.Neon, SM)
	local sl = Instance.new("SurfaceLight")
	sl.Face = Enum.NormalId.Front
	sl.Color = Color3.fromRGB(170, 190, 230)
	sl.Brightness = 1.6
	sl.Range = 16
	sl.Angle = 100
	sl.Parent = scr
	for i = 1, 2 do
		R(m, "Dial", b, V(0.35, 0.35, 0.1), V(1.35, 4.5 - i * 0.7, -1.22), C.Brass, M.Metal, SM)
	end
	for _, sx in { -1, 1 } do
		local a = R(m, "Antenna", b, V(0.08, 2.4, 0.08), V(sx * 0.5, 6.1, 0.3), C.Metal, M.Metal, SM)
		a.CFrame = CFrame.new(B.O) * b * CFrame.new(sx * 0.45, 5.9, 0.3) * CFrame.Angles(0, 0, math.rad(-sx * 25))
	end
	m.PrimaryPart = scr
	B.attrs(m, { Area = area })
	B.tag(m, "Lamp")
	return m
end

function B.bookshelf(par, b, w, h, col, o)
	o = o or {}
	local m = B.model(par, o.name or "Bookshelf")
	local d = 1.6
	R(m, "Back", b, V(w, h, 0.15), V(0, h / 2, d / 2 - 0.08), dark(col, 0.2), M.Wood)
	for _, sx in { -1, 1 } do
		R(m, "Side", b, V(0.2, h, d), V(sx * (w / 2 - 0.1), h / 2, 0), col, M.Wood)
	end
	local n = o.shelves or 4
	local palette = { C.Rose, C.Mint, C.Mustard, C.Bruise, C.Paper, C.Blood, C.Night }
	local seed = o.seed or 1
	for i = 0, n do
		local y = 0.3 + (h - 0.6) * i / n
		R(m, "Shelf", b, V(w - 0.3, 0.15, d - 0.1), V(0, y, 0), col, M.Wood, SM)
		if i < n and not o.empty then
			local x = -w / 2 + 0.35
			local k = 0
			while x < (if o.gap == i then 0 else w / 2 - 0.8) do
				k += 1
				local bw = 0.3 + ((seed * 7 + k * 13 + i * 5) % 5) * 0.12
				local bh = (h - 0.6) / n * (0.62 + ((seed + k * 3 + i) % 4) * 0.07)
				local c = palette[((seed + k * 5 + i * 3) % #palette) + 1]:Lerp(C.Ink, 0.35)
				local gw = bw * 3
				if x + gw > w / 2 - 0.3 then break end
				R(m, "Books", b, V(gw, bh, d * 0.7), V(x + gw / 2, y + 0.08 + bh / 2, 0.05), c, M.Fabric, SM)
				x += gw + 0.15 + ((k + i) % 3) * 0.4
			end
		end
	end
	return m
end

-- picture on a wall. wb = CFrame at the wall surface centre of the picture, LookVector out of the wall
function B.picture(par, wb, w, h, o)
	o = o or {}
	local m = B.model(par, o.name or "Picture")
	local fc = o.frame or C.WoodDark
	if o.back then -- turned to face the wall
		R(m, "Back", wb, V(w, h, 0.18), V(0, 0, -0.09), C.WoodRaw:Lerp(C.Paper, 0.2), M.Cardboard, SM)
		R(m, "Wire", wb, V(w * 0.6, 0.05, 0.05), V(0, h * 0.3, -0.2), C.Metal, M.Metal, SM)
		R(m, "FrameEdge", wb, V(w + 0.2, 0.2, 0.2), V(0, h / 2, -0.1), fc, M.Wood, SM)
		return m
	end
	R(m, "Frame", wb, V(w, h, 0.2), V(0, 0, -0.1), fc, M.Wood, SM)
	local canvas = o.canvas or C.Night
	R(m, "Canvas", wb, V(w - 0.45, h - 0.45, 0.05), V(0, 0, -0.22), canvas, M.Fabric, SM)
	if o.portrait then
		local skin = o.skin or C.Paper:Lerp(C.Rose, 0.2)
		local ph = h - 0.45
		R(m, "Shoulders", wb, V((w - 0.45) * 0.7, ph * 0.28, 0.04), V(0, -ph * 0.36, -0.25), o.clothes or C.Ink, M.Fabric, SM)
		local hd = math.min(w, h) * 0.32
		B.cyl(m, "Head", wb, hd, 0.04, V(0, ph * 0.02, -0.26), skin, M.SmoothPlastic, SM, false).CFrame = CFrame.new(B.O) * wb * CFrame.new(0, ph * 0.02, -0.26) * CFrame.Angles(0, math.rad(90), 0)
		if o.hair then
			B.cyl(m, "Hair", wb, hd * 1.1, 0.03, V(0, ph * 0.1, -0.245), o.hair, M.Fabric, SM, false).CFrame = CFrame.new(B.O) * wb * CFrame.new(0, ph * 0.1, -0.245) * CFrame.Angles(0, math.rad(90), 0)
		end
		if o.eyes then
			for _, sx in { -1, 1 } do
				R(m, "Eye", wb, V(hd * 0.14, hd * 0.1, 0.03), V(sx * hd * 0.18, ph * 0.03, -0.29), o.eyes, M.Neon, SM)
			end
		end
	elseif o.scene then
		R(m, "Hill", wb, V(w - 0.5, (h - 0.5) * 0.35, 0.04), V(0, -(h - 0.5) * 0.3, -0.25), o.scene, M.Fabric, SM)
		B.cyl(m, "Moon", wb, 0.5, 0.04, V(w * 0.2, h * 0.2, -0.25), C.Paper, M.SmoothPlastic, SM, false).CFrame = CFrame.new(B.O) * wb * CFrame.new(w * 0.2, h * 0.2, -0.25) * CFrame.Angles(0, math.rad(90), 0)
	end
	return m
end

